{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable EDP-02 longitudinal probe record",
  "type": "object",
  "required": [
    "record_id",
    "provider",
    "model",
    "family",
    "branch",
    "probe_id",
    "experiment_version",
    "date",
    "model_version",
    "generation",
    "replicate_id",
    "regime",
    "context",
    "phase",
    "variant",
    "messages",
    "raw_response",
    "component_sha256",
    "provenance",
    "inference_parameters",
    "evaluator_scores",
    "evaluator_disagreement",
    "checkpoint_sha256",
    "weights_sha256",
    "topology_sha256",
    "registration_sha256",
    "context_sha256",
    "prompt_sha256",
    "event_sha256",
    "receipt_sha256",
    "wording"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "probe_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_version": {
      "const": "0.2.0-experimental"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "replicate_id": {
      "type": "integer",
      "minimum": 0
    },
    "regime": {
      "enum": [
        "H",
        "E",
        "0"
      ]
    },
    "context": {
      "enum": [
        "in_regime",
        "neutral"
      ]
    },
    "phase": {
      "enum": [
        "main",
        "reversal_before",
        "reversal_after",
        "ablation"
      ]
    },
    "variant": {
      "enum": [
        "E_A",
        "E_B",
        "E_0"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "const": "user"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "raw_response": {
      "type": "string"
    },
    "component_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "inference_parameters": {
      "type": "object"
    },
    "evaluator_scores": {
      "type": "array",
      "maxItems": 0
    },
    "evaluator_disagreement": {
      "type": "null"
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "weights_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "topology_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "wording": {
      "enum": [
        "H",
        "E",
        "0"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "context": {
            "const": "neutral"
          }
        }
      },
      "then": {
        "properties": {
          "messages": {
            "maxItems": 1
          },
          "component_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "probe_id": {
            "const": "P04"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "const": "E_0"
          }
        }
      }
    }
  ]
}
