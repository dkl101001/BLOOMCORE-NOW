{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloomcore.now/contracts/triad-workflow.schema.json",
  "title": "BLOOMCORE NOW Triad Workflow Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "schema", "task_id", "goal", "mode", "route_id", "triad", "selected_aperture", "sources", "epistemic_claims", "execution_profile", "contradictions", "requirements", "requested_claim", "permissions"],
  "properties": {
    "$comment": {"type": "string"},
    "schema": {"const": "BLOOMCORE_NOW.TRIAD_WORKFLOW_PACKET.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "mode": {"enum": ["SAFE", "STRICT", "EXPLORATORY"]},
    "route_id": {"enum": ["AUTHORITY_STATUS", "SOURCE_INTAKE", "IMPLEMENTATION_PROPOSAL", "RESEARCH_APERTURE"]},
    "selected_aperture": {"enum": [null, "PHASE38_SECTION_33_17_DYNAMIC_SCHRODINGER_KERNELS"]},
    "triad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/role"}
        }
      }
    },
    "sources": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/source"}},
    "epistemic_claims": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/claim"}},
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition", "recursion", "exploration", "scheduling", "replay", "persistence", "mutation", "authority"],
      "properties": {
        "transition": {"$ref": "#/$defs/nonemptyStrings"},
        "recursion": {"$ref": "#/$defs/nonemptyStrings"},
        "exploration": {"$ref": "#/$defs/nonemptyStrings"},
        "scheduling": {"$ref": "#/$defs/nonemptyStrings"},
        "replay": {"$ref": "#/$defs/nonemptyStrings"},
        "persistence": {"$ref": "#/$defs/nonemptyStrings"},
        "mutation": {"$ref": "#/$defs/nonemptyStrings"},
        "authority": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "contradictions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contradiction"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "requested_claim": {"const": "BOUNDED_WORKFLOW_PACKET_VERIFIED"},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mutation", "native_mutation", "canonical_promotion", "external_action"],
      "properties": {
        "source_mutation": {"const": false},
        "native_mutation": {"const": false},
        "canonical_promotion": {"const": false},
        "external_action": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source_id", "sha256", "authority"],
      "properties": {
        "role": {"enum": ["SOLE_GOVERNING_MASTER", "BOUNDED_DSK_RESEARCH_COMPANION", "NON_AUTHORITATIVE_DISCOVERY_AND_EXECUTION_ADAPTER"]},
        "source_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "authority": {"enum": ["GOVERNS", "INFORMS_ONLY_WITHIN_SELECTED_APERTURE", "DISCOVERY_AND_EXECUTION_ONLY"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "custody"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "custody": {"enum": ["PRIVATE_REFERENCE", "PUBLIC_SYNTHETIC_FIXTURE"]}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "class", "statement", "source_refs"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["OBSERVED_DOCUMENTED", "RECONSTRUCTED_HISTORICAL_MEANING", "TECHNICAL_INTERPRETATION", "RESEARCH_HYPOTHESIS", "UNRESOLVED_ONTOLOGY"]},
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contradiction_id", "source_refs", "pre_transform", "rejected_interpretations", "unresolved_remainder"],
      "properties": {
        "contradiction_id": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonemptyStrings"},
        "pre_transform": {"type": "string", "minLength": 1},
        "rejected_interpretations": {"$ref": "#/$defs/nonemptyStrings"},
        "unresolved_remainder": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "criterion", "state", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "criterion": {"type": "string", "minLength": 1},
        "state": {"enum": ["OPEN", "BLOCKED", "CLOSED_WITH_EVIDENCE"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
