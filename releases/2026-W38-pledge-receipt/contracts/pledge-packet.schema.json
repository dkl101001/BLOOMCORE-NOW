{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloomcore.example/schemas/pledge-packet-v1.json",
  "title": "BLOOMCORE NOW Pledge Packet v1",
  "type": "object",
  "required": ["schema", "document", "commitments"],
  "properties": {
    "schema": {"const": "BLOOMCORE_NOW.PLEDGE_PACKET.v1"},
    "document": {
      "type": "object",
      "required": ["title", "issuer", "version", "source_url", "source_sha256"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "published": {"type": ["string", "null"]},
        "source_url": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "commitments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "lifecycle": {"enum": ["active", "proposed", "withdrawn", "superseded"]},
          "source_locator": {"type": ["string", "null"]},
          "actor": {"type": ["string", "null"]},
          "action": {"type": ["string", "null"]},
          "scope": {"type": ["string", "null"]},
          "trigger": {"type": ["string", "null"]},
          "evidence": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}},
          "deadline_or_cadence": {"type": ["string", "null"]},
          "exceptions": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}},
          "consequence": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
