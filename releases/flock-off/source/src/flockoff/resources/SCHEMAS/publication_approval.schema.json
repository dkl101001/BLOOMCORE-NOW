{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flockoff.local/schemas/v1/publication_approval.schema.json",
  "title": "FLOCK OFF explicit local-draft publication approval",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "approval_type",
    "scope",
    "policy_version",
    "request_digest",
    "approved_at_utc",
    "acknowledgements"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approval_id": {"type": "string", "pattern": "^approval_[a-f0-9]{32,64}$"},
    "approval_type": {"const": "LOCAL_OPERATOR_OPT_IN"},
    "scope": {"const": "LOCAL_DRAFT_ONLY"},
    "policy_version": {"const": "public-export-1.0.0"},
    "request_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "approved_at_utc": {"type": "string", "format": "date-time"},
    "acknowledgements": {
      "type": "object",
      "required": [
        "route_data_excluded",
        "raw_identifiers_excluded",
        "remote_id_operator_positions_excluded",
        "contradictions_preserved",
        "no_automatic_publication"
      ],
      "properties": {
        "route_data_excluded": {"const": true},
        "raw_identifiers_excluded": {"const": true},
        "remote_id_operator_positions_excluded": {"const": true},
        "contradictions_preserved": {"const": true},
        "no_automatic_publication": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
