{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flockoff.local/schemas/v1/local_alert.schema.json",
  "title": "FLOCK OFF private local alert",
  "type": "object",
  "required": ["schema_version", "local_alert_id", "alert_type", "created_at_utc", "observation_ref", "track_revision_ref", "node_revision_ref", "evidence_basis", "motion_state", "remote_id_validity", "surveillance_capability_claim", "probability", "publication_state", "receipt_id"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "local_alert_id": {"type": "string", "pattern": "^alert_[a-f0-9]{32,64}$"},
    "alert_type": {"const": "REMOTE_ID_MOBILE_TRACK_OBSERVED"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "observation_ref": {"type": "string", "pattern": "^obs_[a-f0-9]{32,64}$"},
    "track_revision_ref": {"type": "string", "pattern": "^trackrev_[a-f0-9]{32,64}$"},
    "node_revision_ref": {"type": "string", "pattern": "^node_[a-f0-9]{32,64}:revision:[1-9][0-9]*$"},
    "evidence_basis": {"const": "BROADCAST_REMOTE_ID"},
    "motion_state": {"const": "MOBILE"},
    "remote_id_validity": {"enum": ["VALID", "UNVERIFIED", "INCOMPLETE"]},
    "surveillance_capability_claim": {"const": false},
    "probability": {"type": "null"},
    "publication_state": {"const": "PRIVATE_LOCAL"},
    "receipt_id": {"type": "string", "pattern": "^receipt_[a-f0-9]{32,64}$"}
  },
  "additionalProperties": false
}
