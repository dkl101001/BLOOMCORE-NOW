{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flockoff.local/schemas/v1/pass_partition.schema.json",
  "title": "FLOCK OFF observation pass partition",
  "type": "object",
  "required": ["schema_version", "partition_id", "session_id", "algorithm", "observation_pass_map", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "partition_id": {"type": "string", "pattern": "^partition_[a-f0-9]{32,64}$"},
    "session_id": {"type": "string", "minLength": 1},
    "algorithm": {
      "type": "object",
      "required": ["name", "version", "code_revision", "code_digest"],
      "properties": {
        "name": {"const": "caller_explicit_pass_partition"},
        "version": {"type": "string", "minLength": 1},
        "code_revision": {"type": "string", "minLength": 1},
        "code_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "observation_pass_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^obs_[a-f0-9]{32,64}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
