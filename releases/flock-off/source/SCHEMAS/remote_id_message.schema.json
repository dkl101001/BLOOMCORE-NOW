{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flockoff.local/schemas/v1/remote_id_message.schema.json",
  "title": "FLOCK OFF typed decoded Remote ID message event",
  "type": "object",
  "required": ["schema_version", "implementation_state", "message_id", "observation_ref", "message_type", "transport", "received_at_utc", "clock_uncertainty_ms", "receiver_ref", "hardware_profile_id", "decoder_lock", "transport_metadata", "syntax_state", "semantic_state", "freshness_state", "replay_state", "authentication", "decoded_body", "restricted_field_refs", "payload_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "implementation_state": {"const": "IMPLEMENTED_DECODED_UPSTREAM"},
    "message_id": {"type": "string", "pattern": "^ridmsg_[a-f0-9]{32,64}$"},
    "observation_ref": {"type": "string", "pattern": "^obs_[a-f0-9]{32,64}$"},
    "message_type": {"enum": ["BASIC_ID", "LOCATION_VECTOR", "SYSTEM", "SELF_ID", "OPERATOR_ID", "AUTHENTICATION", "MESSAGE_PACK", "UNKNOWN"]},
    "transport": {"enum": ["BLUETOOTH_LEGACY", "BLUETOOTH_5_LONG_RANGE", "WIFI_NAN", "WIFI_BEACON"]},
    "received_at_utc": {"type": "string", "format": "date-time"},
    "clock_uncertainty_ms": {"type": "number", "minimum": 0},
    "receiver_ref": {"type": "string", "minLength": 1},
    "hardware_profile_id": {"type": "string", "minLength": 1},
    "decoder_lock": {
      "type": "object",
      "required": ["decoder_name", "decoder_version", "source_ref", "source_revision", "core_source_ref", "core_revision", "standard_profile_ref"],
      "properties": {
        "decoder_name": {"type": "string", "minLength": 1},
        "decoder_version": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "core_source_ref": {"type": "string", "minLength": 1},
        "core_revision": {"type": "string", "minLength": 1},
        "standard_profile_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "transport_metadata": {
      "type": "object",
      "required": ["band", "channel", "center_frequency_hz", "receiver_capability_ref"],
      "properties": {
        "band": {"type": ["string", "null"]},
        "channel": {"type": ["integer", "null"], "minimum": 0},
        "center_frequency_hz": {"type": ["integer", "null"], "minimum": 0},
        "receiver_capability_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "syntax_state": {"enum": ["VALID", "MALFORMED", "UNSUPPORTED_VERSION"]},
    "semantic_state": {"enum": ["VALID", "INCOMPLETE", "OUT_OF_RANGE", "CONTRADICTED", "NOT_EVALUATED"]},
    "freshness_state": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
    "replay_state": {"enum": ["NOT_SUSPECTED", "SUSPECTED", "UNKNOWN"]},
    "authentication": {
      "type": "object",
      "required": ["present", "verification", "trust_anchor_state", "verification_receipt_id"],
      "properties": {
        "present": {"type": "boolean"},
        "verification": {"enum": ["NOT_CHECKED", "VALID", "INVALID", "UNSUPPORTED", "NOT_PRESENT"]},
        "trust_anchor_state": {"enum": ["TRUSTED", "UNTRUSTED", "UNKNOWN", "NOT_APPLICABLE"]},
        "verification_receipt_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^receipt_[a-f0-9]{32,64}$"}
          ]
        }
      },
      "additionalProperties": false
    },
    "decoded_body": {
      "type": "object",
      "properties": {
        "uas_id_type": {"type": ["string", "null"]},
        "uas_id_rotating_hash": {"type": ["string", "null"], "pattern": "^ephem:[a-f0-9]{64}$"},
        "aircraft_position": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["latitude", "longitude", "altitude_m", "altitude_reference", "horizontal_accuracy_m", "vertical_accuracy_m"],
              "properties": {
                "latitude": {"type": "number", "minimum": -90, "maximum": 90},
                "longitude": {"type": "number", "minimum": -180, "maximum": 180},
                "altitude_m": {"type": ["number", "null"]},
                "altitude_reference": {"enum": ["WGS84", "MSL", "AGL", "UNKNOWN"]},
                "horizontal_accuracy_m": {"type": ["number", "null"], "minimum": 0},
                "vertical_accuracy_m": {"type": ["number", "null"], "minimum": 0}
              },
              "additionalProperties": false
            }
          ]
        },
        "speed_mps": {"type": ["number", "null"], "minimum": 0},
        "heading_deg": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360},
        "height_m": {"type": ["number", "null"]},
        "operator_identifier_rotating_hash": {"type": ["string", "null"], "pattern": "^ephem:[a-f0-9]{64}$"},
        "self_id_text_digest": {"type": ["string", "null"], "pattern": "^(sha256|hmac-sha256):[a-f0-9]{64}$"},
        "authentication_page_number": {"type": ["integer", "null"], "minimum": 0},
        "authentication_page_count": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "restricted_field_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ridrestricted_[a-f0-9]{32,64}$"},
      "uniqueItems": true
    },
    "payload_digest": {"type": "string", "pattern": "^(sha256|hmac-sha256):[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "required": ["authentication"],
        "properties": {
          "authentication": {
            "required": ["verification"],
            "properties": {"verification": {"const": "VALID"}}
          }
        }
      },
      "then": {
        "properties": {
          "authentication": {
            "properties": {
              "trust_anchor_state": {"const": "TRUSTED"},
              "verification_receipt_id": {"type": "string", "pattern": "^receipt_[a-f0-9]{32,64}$"}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
