{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flockoff.local/schemas/v1.2/target_expectation.schema.json",
  "title": "FLOCK OFF bounded live target expectation",
  "type": "object",
  "required": [
    "schema_version",
    "target_asset_ref",
    "signature_ref",
    "latitude",
    "longitude",
    "trigger_radius_m",
    "exit_radius_m",
    "target_evidence_refs",
    "failed_assumption",
    "next_tests"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "target_asset_ref": {
      "type": "string",
      "minLength": 1
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "trigger_radius_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "exit_radius_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "failed_assumption": {
      "type": "string",
      "minLength": 1
    },
    "next_tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_pose_count": {
      "type": "integer",
      "minimum": 2,
      "default": 2
    },
    "cooldown_seconds": {
      "type": "number",
      "minimum": 0,
      "default": 60
    },
    "target_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "trigger_radius_m",
          "exit_radius_m"
        ]
      },
      "then": {
        "properties": {
          "exit_radius_m": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
