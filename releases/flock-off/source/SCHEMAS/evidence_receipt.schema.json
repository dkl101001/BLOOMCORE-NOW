{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flockoff.local/schemas/v1/evidence_receipt.schema.json",
  "title": "FLOCK OFF deterministic evidence receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "receipt_hash", "body", "attestation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^receipt_[a-f0-9]{32,64}$"},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "body": {
      "type": "object",
      "required": ["receipt_version", "subject_ref", "input_refs", "input_hashes", "algorithm", "parameters", "parameters_hash", "output_hash", "source_locks", "code_revision", "code_digest"],
      "properties": {
        "receipt_version": {"const": "1.0.0"},
        "subject_ref": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input_hashes": {"type": "array", "items": {"type": "string", "pattern": "^(sha256|hmac-sha256):[a-f0-9]{64}$"}},
        "algorithm": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "parameters": {"type": "object"},
        "parameters_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "output_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_locks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "revision", "content_hash"],
            "properties": {
              "source_id": {"type": "string"},
              "revision": {"type": "string"},
              "content_hash": {"type": ["string", "null"], "pattern": "^(sha256:)?[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "code_revision": {"type": "string", "minLength": 1},
        "code_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "attestation": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["created_at_utc", "signer_id", "signature_algorithm", "signature"],
          "properties": {
            "created_at_utc": {"type": "string", "format": "date-time"},
            "signer_id": {"type": "string"},
            "signature_algorithm": {"enum": ["ED25519", "NONE"]},
            "signature": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
